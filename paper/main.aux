\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Exact $P_{\mathrm  {win}}$ for representative three-ticket intersection profiles of the Lotofácil (Proposition~\ref {prop:three-ticket}). $\Omega = \DOTSB \sum@ \slimits@ _{i<j} m_{ij}$; $c$ = triple intersection (a dash means every admissible $c$ gives the same $P_{\mathrm  {win}}$). The balanced profile $\{7,7,6\}$ is the global optimum (Theorem~\ref {thm:three-optimal}); profiles containing a minimum-overlap pair are strictly suboptimal. For comparison, random selection achieves $U_3 = 0.285217$ in expectation (Proposition~\ref {prop:random-benchmark}).}}{13}{table.2}\protected@file@percent }
\newlabel{tab:three-profiles}{{2}{13}{Exact $\Pwin $ for representative three-ticket intersection profiles of the Lotofácil (Proposition~\ref {prop:three-ticket}). $\Omega = \sum _{i<j} m_{ij}$; $c$ = triple intersection (a dash means every admissible $c$ gives the same $\Pwin $). The balanced profile $\{7,7,6\}$ is the global optimum (Theorem~\ref {thm:three-optimal}); profiles containing a minimum-overlap pair are strictly suboptimal. For comparison, random selection achieves $U_3 = 0.285217$ in expectation (Proposition~\ref {prop:random-benchmark})}{table.2}{}}
\newlabel{thm:certified-optima}{{3.15}{13}{Exact optima for four, five and six Lotofácil tickets; computer-assisted}{theorem.3.15}{}}
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces Certified global optima for the Lotof\'{a}cil. $\Omega = \DOTSB \sum@ \slimits@ _{i<j} m_{ij}$ equals the degree bound of Proposition~\ref {prop:degree-bound} in every case. Profiles are written as multisets of the $\binom  {n}{2}$ pairwise overlaps; the graph formed by the pairs at overlap $8$ is indicated in brackets. The last column is the absolute gain over the independence benchmark $U_n$, which uncoordinated random play attains in expectation (Proposition~\ref {prop:random-benchmark}).}}{14}{table.3}\protected@file@percent }
\newlabel{tab:certified-optima}{{3}{14}{Certified global optima for the Lotof\'{a}cil. $\Omega = \sum _{i<j} m_{ij}$ equals the degree bound of Proposition~\ref {prop:degree-bound} in every case. Profiles are written as multisets of the $\binom {n}{2}$ pairwise overlaps; the graph formed by the pairs at overlap $8$ is indicated in brackets. The last column is the absolute gain over the independence benchmark $U_n$, which uncoordinated random play attains in expectation (Proposition~\ref {prop:random-benchmark})}{table.3}{}}
\newlabel{eq:bonferroni-ub}{{13}{14}{Three and more tickets: exact structure and the limits of monotonicity}{equation.13}{}}
