\newlabel{prop:three-ticket}{{3.11}{11}{Exact three-ticket decomposition}{proposition.3.11}{}}
\newlabel{ex:ill-posed}{{3.12}{12}{Pairwise overlaps do not determine $\Pwin $}{example.3.12}{}}
