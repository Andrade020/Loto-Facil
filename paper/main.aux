\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Joint-win probability $g(m)$ and its increment for the Lotofácil $(v=25,\,k=15,\,t=11)$. Values computed by exact enumeration of the multivariate hypergeometric distribution; the increments $\Delta _g = g(m+1)-g(m)$ agree with the closed form \eqref  {eq:increment} and illustrate Theorem~\ref {thm:two-ticket-monotone}. Note that the increments are themselves increasing ($g$ is convex on this range), which drives the balanced-profile phenomenon of Section~\ref {sec:general-n}. The fact $g(5)=g(6)=0$ (Proposition~\ref {prop:mutual-excl}) implies $P_{\mathrm  {win}}= 2p \approx 0.2118$ at both $m=5$ and $m=6$.}}{10}{table.1}\protected@file@percent }
\newlabel{tab:delta-g}{{1}{10}{Joint-win probability $g(m)$ and its increment for the Lotofácil $(v=25,\,k=15,\,t=11)$. Values computed by exact enumeration of the multivariate hypergeometric distribution; the increments $\Delta _g = g(m+1)-g(m)$ agree with the closed form \eqref {eq:increment} and illustrate Theorem~\ref {thm:two-ticket-monotone}. Note that the increments are themselves increasing ($g$ is convex on this range), which drives the balanced-profile phenomenon of Section~\ref {sec:general-n}. The fact $g(5)=g(6)=0$ (Proposition~\ref {prop:mutual-excl}) implies $\Pwin = 2p \approx 0.2118$ at both $m=5$ and $m=6$}{table.1}{}}
\newlabel{cor:min-overlap-optimal}{{3.8}{10}{Minimum overlap is optimal for $n=2$}{corollary.3.8}{}}
